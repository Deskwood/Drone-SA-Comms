    {
      "lab": "L9_LoRA_Adapted",
      "enabled": true,
      "seeds": "1-100",
      "max_rounds": 32,
      "use_gui": false,
      "label": "L9 [R2,P1,DS3,M1,FT1,A3] - LoRA-adapted variant",
      "notes": "Rebuild LoRA adapter from the fresh L7 baseline logfile before running this lab.",
      "optuna": {
        "enabled": false
      },
      "lora": {
        "enabled": true,
        "commands": [
          [
            "python",
            "build_lora_dataset.py",
            "--log",
            "{lab_logfile:L7}",
            "--rules",
            "profiles/rules/R2_rules.txt",
            "--out-dir",
            "lora",
            "--mode",
            "summary",
            "--dataset-prefix",
            "l4",
            "--train-seeds",
            "1-80",
            "--val-seeds",
            "81-100"
          ],
          [
            "llamafactory-cli",
            "train",
            "lora/l4_lora.yaml"
          ],
          [
            "llamafactory-cli",
            "export",
            "lora/l4_export.yaml"
          ],
          [
            "python",
            "register_ollama_model.py",
            "--export-yaml",
            "lora/l4_export.yaml",
            "--model-name",
            "corasat-l4-lora",
            "--modelfile",
            "lora/Modelfile.l4"
          ]
        ]
      }
    }
  ]
}
