{
  "schema_version": 2,
  "board": {
    "width": 8,
    "height": 8
  },
  "rules_path": "profiles/rules/R2_rules.txt",
  "simulation": {
    "create_py_export": false,
    "use_gui": false,
    "model_index": 4,
    "models": [
      "manual",
      "deepseek-r1:32b",
      "qwen3:30b",
      "deepseek-r1:14b",
      "llama3.1:8b"
    ],
    "num_drones": 2,
    "max_rounds": 32,
    "temperature": 0.0,
    "seed_list": {
      "first_seed": 1,
      "last_seed": 100
    },
    "top_p": null,
    "top_k": null,
    "watchdog_timeout_s": 900
  },
  "gui": {
    "cell_size": 80,
    "margin": 8,
    "figure_image_dir": "./img",
    "sidebar_width": 600
  },
  "decision_support": {
    "enabled": true,
    "output": {
      "include_scoring": true,
      "include_summary": true
    },
    "scoring": {
      "move": {
        "waypoint_progress_bonus": 0.5,
        "waypoint_delay_penalty": -3.0,
        "unknown_tile_bonus": 1.3,
        "no_figures_left_behind_bonus": 1.5,
        "neighborhood_potential": 0.1,
        "figure_hint_bonus": 1.0,
        "possible_target_bonus": 0.9,
        "neighborhood_weight_any_figure": 0.4,
        "neighborhood_weight_possible_target": 0.7,
        "border_bonus": 1.0,
        "cross_track_penalty_per_step_squared": -1.0,
        "sector_compliance_bonus": 0.8,
        "revisit_penalty": -1.0
      },
      "broadcast": {
        "base_broadcast_value": -0.6,
        "first_turn_coordination_bonus": 2.5,
        "last_turn_coordination_bonus": 8.0
      },
      "wait": {
        "base_wait_value": -1.68
      }
    }
  },
  "prompt_requests": {
    "rationale": "Rationale: <=2 sentences. Mention the top Decision Support factor(s) or the mandatory rule you are following.",
    "action": "Action: choose one of wait, move, broadcast. Follow rules; if Special directive says Drone 1 on round 1, you MUST broadcast.",
    "action_move": "Direction: choose ONLY from Legal moves.",
    "action_broadcast": "Message: If broadcast, send the JSON coverage plan on the first turn. Otherwise send a brief update only when co-located drones need it.",
    "memory_update": "Memory: Use tags PLAN:, SECTOR:, RV:, FIG:, POSSIBLE:, NOTE:, VISITED:. Keep existing VISITED lines. Do NOT copy Decision Support, Legal movements, or Broadcast Rx Buffer."
  },
  "campaign": {
    "name": "mt_full_rerun",
    "output_dir": "campaign_runs/mt_full_rerun",
    "fresh_output": true,
    "stop_on_error": true,
    "seed_list": {
      "first_seed": 1,
      "last_seed": 100
    },
    "max_rounds": 32,
    "use_gui": false,
    "logging": {
      "include_timestamps": true
    },
    "labs": [
      {
        "id": "L0",
        "enabled": true,
        "title": "Random legal baseline (no LM)",
        "label": "L0 [R0,P0,DS0,M0,FT0,A0] - Random legal baseline (no LM)",
        "notes": "Seeded random policy that samples only legal moves.",
        "rules_id": "R0",
        "prompt_id": "P0",
        "drone_support_id": "DS0",
        "model_id": "M0",
        "fine_tuning_id": "FT0",
        "action_policy_id": "A0",
        "optuna": {
          "enabled": false
        },
        "lora": {
          "enabled": false,
          "commands": []
        }
      },
      {
        "id": "L1",
        "enabled": true,
        "title": "Rules-only baseline",
        "label": "L1 [R2,P2,DS0,M1,FT0,A2] - Rules-only baseline",
        "notes": "LLM with full rules and no decision support.",
        "rules_id": "R2",
        "prompt_id": "P2",
        "drone_support_id": "DS0",
        "model_id": "M1",
        "fine_tuning_id": "FT0",
        "action_policy_id": "A2",
        "optuna": {
          "enabled": false
        },
        "lora": {
          "enabled": false,
          "commands": []
        }
      },
      {
        "id": "L2",
        "enabled": true,
        "title": "Decision-support-only baseline (no LM)",
        "label": "L2 [R0,P0,DS1,M0,FT0,A1] - Decision-support-only baseline (no LM)",
        "notes": "Deterministic policy that executes the top decision-support action.",
        "rules_id": "R0",
        "prompt_id": "P0",
        "drone_support_id": "DS1",
        "model_id": "M0",
        "fine_tuning_id": "FT0",
        "action_policy_id": "A1",
        "optuna": {
          "enabled": false
        },
        "lora": {
          "enabled": false,
          "commands": []
        }
      },
      {
        "id": "L3",
        "enabled": true,
        "title": "Baseline (pre-Optuna)",
        "label": "L3 [R2,P2,DS1,M1,FT0,A3] - Baseline (pre-Optuna)",
        "notes": "Decision-support-assisted LLM baseline.",
        "rules_id": "R2",
        "prompt_id": "P2",
        "drone_support_id": "DS1",
        "model_id": "M1",
        "fine_tuning_id": "FT0",
        "action_policy_id": "A3",
        "optuna": {
          "enabled": false
        },
        "lora": {
          "enabled": false,
          "commands": []
        }
      },
      {
        "id": "L4",
        "enabled": true,
        "title": "Waypoint clarification ablation",
        "label": "L4 [R3,P3,DS1,M1,FT0,A3] - Waypoint clarification ablation",
        "notes": "Adds explicit waypoint-vs-sector disambiguation in rules and prompts.",
        "rules_id": "R3",
        "prompt_id": "P3",
        "drone_support_id": "DS1",
        "model_id": "M1",
        "fine_tuning_id": "FT0",
        "action_policy_id": "A3",
        "optuna": {
          "enabled": false
        },
        "lora": {
          "enabled": false,
          "commands": []
        }
      },
      {
        "id": "L5",
        "enabled": true,
        "title": "Reduced context (Optuna-1)",
        "label": "L5 [R1,P1,DS2,M1,FT0,A3] - Reduced context (Optuna-1)",
        "notes": "Reduced context rules/prompts with DS2 scoring.",
        "rules_id": "R1",
        "prompt_id": "P1",
        "drone_support_id": "DS2",
        "model_id": "M1",
        "fine_tuning_id": "FT0",
        "action_policy_id": "A3",
        "optuna": {
          "enabled": false
        },
        "lora": {
          "enabled": false,
          "commands": []
        }
      },
      {
        "id": "L6",
        "enabled": true,
        "title": "Full-rules variant with Optuna-1 weights",
        "label": "L6 [R2,P1,DS2,M1,FT0,A3] - Full-rules variant with Optuna-1 weights",
        "notes": "Full rules with DS2 scoring for direct comparison to L5.",
        "rules_id": "R2",
        "prompt_id": "P1",
        "drone_support_id": "DS2",
        "model_id": "M1",
        "fine_tuning_id": "FT0",
        "action_policy_id": "A3",
        "optuna": {
          "enabled": false
        },
        "lora": {
          "enabled": false,
          "commands": []
        }
      },
      {
        "id": "L7",
        "enabled": true,
        "title": "Optuna-2 tuning stage",
        "label": "L7 [R2,P1,DS3,M1,FT0,A3] - Optuna-2 tuning stage",
        "notes": "Set optuna.enabled=true to retune in this campaign.",
        "rules_id": "R2",
        "prompt_id": "P1",
        "drone_support_id": "DS3",
        "model_id": "M1",
        "fine_tuning_id": "FT0",
        "action_policy_id": "A3",
        "optuna": {
          "enabled": true,
          "trials": 55,
          "seeds": "1",
          "sampler_seed": 1,
          "max_rounds": 32,
          "no_prune": false
        },
        "lora": {
          "enabled": false,
          "commands": []
        }
      },
      {
        "id": "L8",
        "enabled": true,
        "title": "DeepSeek model-swap baseline",
        "label": "L8 [R1,P1,DS2,M2,FT0,A3] - DeepSeek model-swap baseline",
        "notes": "Model swap baseline under same DS and prompt/rules regime.",
        "rules_id": "R1",
        "prompt_id": "P1",
        "drone_support_id": "DS2",
        "model_id": "M2",
        "fine_tuning_id": "FT0",
        "action_policy_id": "A3",
        "optuna": {
          "enabled": false
        },
        "lora": {
          "enabled": false,
          "commands": []
        }
      },
      {
        "id": "L9",
        "enabled": true,
        "title": "LoRA-adapted variant",
        "label": "L9 [R2,P1,DS3,M1,FT1,A3] - LoRA-adapted variant",
        "notes": "Rebuild LoRA adapter from fresh L7 logs before running this lab.",
        "rules_id": "R2",
        "prompt_id": "P1",
        "drone_support_id": "DS3",
        "model_id": "M1",
        "fine_tuning_id": "FT1",
        "action_policy_id": "A3",
        "optuna": {
          "enabled": false
        },
        "lora": {
          "enabled": true,
          "commands": [
            [
              "python",
              "build_lora_dataset.py",
              "--log",
              "{lab_logfile:L7}",
              "--rules",
              "profiles/rules/R2_rules.txt",
              "--out-dir",
              "lora",
              "--mode",
              "summary",
              "--dataset-prefix",
              "l4",
              "--train-seeds",
              "1-80",
              "--val-seeds",
              "81-100"
            ],
            [
              "llamafactory-cli",
              "train",
              "lora/l4_lora.yaml"
            ],
            [
              "llamafactory-cli",
              "export",
              "lora/l4_export.yaml"
            ],
            [
              "python",
              "register_ollama_model.py",
              "--export-yaml",
              "lora/l4_export.yaml",
              "--model-name",
              "corasat-l4-lora",
              "--modelfile",
              "lora/Modelfile.l4"
            ]
          ]
        }
      }
    ]
  }
}
