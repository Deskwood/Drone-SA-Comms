    "scoring": {
      "move": {
        "waypoint_progress_bonus": 0.5,
        "waypoint_delay_penalty": -3.0,
        "unknown_tile_bonus": 1.3,
        "no_figures_left_behind_bonus": 1.5,
        "neighborhood_potential": 0.1,
        "figure_hint_bonus": 1.0,
        "possible_target_bonus": 0.9,
        "neighborhood_weight_any_figure": 0.4,
        "neighborhood_weight_possible_target": 0.7,
        "border_bonus": 1.0,
        "cross_track_penalty_per_step_squared": -1.0,
        "sector_compliance_bonus": 0.8,
        "revisit_penalty": -1.0
      },
      "broadcast": {
        "base_broadcast_value": -0.6,
        "first_turn_coordination_bonus": 2.5,
        "last_turn_coordination_bonus": 8.0
      },
      "wait": {
        "base_wait_value": -1.68
      }
    }
  },
  "prompt_requests": {
    "rationale": "Rationale: Less than four sentences, why you chose to follow Decision Support recommendations or do something different.",
    "action": "Action: Choose one of wait, move, broadcast.",
    "action_move": "Direction: If action is move,choose ONLY from Legal moves.",
    "action_broadcast": "Message: If action is broadcast, send the JSON coverage plan on the first turn. Otherwise send a brief update only when co-located drones need it.",
    "memory_update": "Memory: Store any information relevant for future decisions."
  },
